{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@oneatlas/db": ["../../packages/db/src/index.ts"],
      "@oneatlas/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src", "next.config.js", "../../packages/db/src", "../../packages/shared/src"],
  "exclude": ["node_modules"]
}
