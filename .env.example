# =============================================================================
# OneAtlas.dev — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# NODE
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE — Neon Postgres
# Get these from: https://console.neon.tech
# DATABASE_URL uses connection pooling (pgBouncer) for serverless
# DIRECT_URL is the direct connection for Prisma migrations
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://neondb_owner:npg_de9HA6gCTVql@ep-dawn-meadow-aq78ckyt-pooler.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:npg_de9HA6gCTVql@ep-dawn-meadow-aq78ckyt.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# -----------------------------------------------------------------------------
# AUTHENTICATION — Clerk
# Get these from: https://dashboard.clerk.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX
CLERK_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# -----------------------------------------------------------------------------
# AI PROVIDERS
# -----------------------------------------------------------------------------
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXX

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXX

# Google Gemini — https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=XXXXXXXXXXXXXXXXXXXX

# DeepSeek — https://platform.deepseek.com/
DEEPSEEK_API_KEY=XXXXXXXXXXXXXXXXXXXX

# Which model to use by default per task tier
AI_FAST_MODEL=gpt-4o-mini          # cheap/fast — CRUD generation, boilerplate
AI_SMART_MODEL=claude-sonnet-4-20250514  # strong reasoning — complex generation
AI_EMBED_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# CACHE — Upstash Redis
# Get these from: https://console.upstash.com/
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://XXXXXXXXXXXXXXXXXXXX.upstash.io
UPSTASH_REDIS_REST_TOKEN=XXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# STORAGE — Cloudflare R2
# Get from Cloudflare dashboard → R2
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=XXXXXXXXXXXXXXXXXXXX
R2_ACCESS_KEY_ID=XXXXXXXXXXXXXXXXXXXX
R2_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXX
R2_BUCKET_NAME=oneatlas-assets
R2_PUBLIC_URL=https://assets.oneatlas.dev

# -----------------------------------------------------------------------------
# DEPLOYMENT — Cloudflare
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=XXXXXXXXXXXXXXXXXXXX
CLOUDFLARE_ACCOUNT_ID=XXXXXXXXXXXXXXXXXXXX
CLOUDFLARE_ZONE_ID=XXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# MONITORING
# -----------------------------------------------------------------------------
# PostHog — https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Better Stack (Logtail) — https://betterstack.com
BETTERSTACK_SOURCE_TOKEN=XXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# APP CONFIG
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=oneatlas.app
APP_SECRET=a-very-long-random-secret-string-change-this
